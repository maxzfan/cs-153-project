{
  "name": "rhino-studio",
  "description": "Desktop app for 3D model version control with Rhino3D files",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "0studio",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "npm run build:electron && concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:pack": "npm run build && electron-builder",
    "electron:dist": "npm run build && npm run build:electron && electron-builder --publish=never",
    "copy:resources": "node scripts/copy-resources.cjs",
    "build:electron": "npm run copy:resources && tsc -p electron/tsconfig.json && tsc -p electron/preload-tsconfig.json && node -e \"require('fs').renameSync('dist-electron/preload.js','dist-electron/preload.cjs')\"",
    "build:all": "npm run build && npm run build:electron && electron-builder --publish=never",
    "watch:electron": "tsc -w -p electron/tsconfig.json",
    "test:electron": "npm run build:electron && node --test dist-electron/**/*.test.js",
    "lint:no-console": "node scripts/lint-no-console.cjs",
    "smoke:oauth": "node scripts/smoke-oauth.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@stripe/react-stripe-js": "^5.5.0",
    "@stripe/stripe-js": "^8.6.4",
    "@supabase/supabase-js": "^2.90.0",
    "@tanstack/react-query": "^5.83.0",
    "chokidar": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "electron-log": "^5.4.3",
    "embla-carousel-react": "^8.6.0",
    "fossil-delta": "^2.0.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "rhino3dm": "^8.17.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.160.1",
    "vaul": "^0.9.9",
    "web-ifc": "^0.0.77",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@julr/vite-plugin-validate-env": "^2.2.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.23",
    "browserslist": "^4.28.1",
    "caniuse-lite": "^1.0.30001766",
    "concurrently": "^9.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.5.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lovable-tagger": "^1.1.13",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.1",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.rhinostudio.app",
    "productName": "0studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asarUnpack": [
      "dist/rhino3dm/**",
      "dist/web-ifc/**",
      "node_modules/chokidar/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/main.js",
      "dist-electron/preload.cjs",
      "dist-electron/services/**/*",
      "dist-electron/workers/**/*",
      "assets/**/*",
      "!**/*.map",
      "!**/*.dmg",
      "!**/*.zip",
      "!**/*.exe",
      "!**/*.blockmap"
    ],
    "afterPack": "./scripts/afterPack.cjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "3dm",
          "name": "Rhino 3D Model",
          "description": "Rhino 3D Model File"
        },
        {
          "ext": "rvt",
          "name": "Revit Project",
          "description": "Autodesk Revit Project File"
        },
        {
          "ext": "ifc",
          "name": "IFC Model",
          "description": "Industry Foundation Classes (BIM) File"
        }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "backgroundColor": "#ffffff"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "3dm",
          "name": "Rhino 3D Model",
          "description": "Rhino 3D Model File"
        },
        {
          "ext": "rvt",
          "name": "Revit Project",
          "description": "Autodesk Revit Project File"
        },
        {
          "ext": "ifc",
          "name": "IFC Model",
          "description": "Industry Foundation Classes (BIM) File"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "0studio",
      "deleteAppDataOnUninstall": false,
      "license": "build/license.rtf"
    }
  }
}
